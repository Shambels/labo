            "start_col_offset_idx": 1,
            "end_col_offset_idx": 2,
            "text": "Une formation de sensibilisation \u00e0 l'hame\u00e7onnage est obligatoire pour tout le personnel administratif avant le 31 mars 2026.",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          }
        ],
