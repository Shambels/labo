              "start_row_offset_idx": 1,
              "end_row_offset_idx": 2,
              "start_col_offset_idx": 1,
              "end_col_offset_idx": 2,
              "text": "L'authentification multifacteur (MFA) devient obligatoire pour tous les comptes au plus tard le 28 f\u00e9vrier 2026.",
              "column_header": false,
              "row_header": false,
              "row_section": false,
              "fillable": false
            }
          ],
          [
