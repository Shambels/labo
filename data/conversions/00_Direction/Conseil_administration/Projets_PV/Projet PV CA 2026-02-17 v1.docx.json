      ],
      "content_layer": "body",
      "label": "section_header",
      "prov": [],
      "orig": "2. Rapport de l'administratrice d\u00e9l\u00e9gu\u00e9e",
      "text": "2. Rapport de l'administratrice d\u00e9l\u00e9gu\u00e9e",
      "level": 2
    },
    {
      "self_ref": "#/texts/8",
      "parent": {
        "$ref": "#/texts/7"
      },
      "children": [],
      "content_layer": "body",
      "label": "text",
      "prov": [],
      "orig": "Le projet ERP est retard\u00e9 : la mise en production est report\u00e9e du 1er avril au 1er juin 2026, en raison de la qualit\u00e9 des donn\u00e9es articles et de l'interface avec le WMS de Gand.",
      "text": "Le projet ERP est retard\u00e9 : la mise en production est report\u00e9e du 1er avril au 1er juin 2026, en raison de la qualit\u00e9 des donn\u00e9es articles et de l'interface avec le WMS de Gand.",
      "formatting": {
        "bold": false,
        "italic": false,
        "underline": false,
        "strikethrough": false,
        "script": "baseline"
      }
    },
