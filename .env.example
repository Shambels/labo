# Copy to .env and fill in. .env is git-ignored: never commit it.

# Read by docker-compose.yaml
DB_USER=calorvia
DB_PASSWORD=change-me
DB_NAME=calorvia
# The same, as a URL, read by the application
POSTGRES_URL=postgresql://calorvia:change-me@localhost:5432/calorvia

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me

LLM_URL=http://localhost:8000/v1
EMBEDDINGS_URL=http://localhost:8001/v1
RERANK_URL=http://localhost:8002/rerank
VLM_URL=http://localhost:8003/v1
JUDGE_URL=http://localhost:8003/v1
JUDGE_MODEL=gemma4-26b-a4b

# Holds the embedder/, reranker/ and docling/ folders
MODELS_PATH=/path/to/models

# DeepEval sends usage telemetry to an external service unless told not to
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Phase B: the three source databases, restored with the course's compose file:
#   docker compose -f enonces/calorvia_t2sql/sources_calorvia/docker/docker-compose.yml --env-file .env up -d
# SQL Server: at least 8 characters with 3 of the 4 classes (upper case, lower case, digit, symbol); no apostrophe.
MSSQL_SA_PASSWORD=change-me
PG_ADMIN_USER=calorvia
PG_ADMIN_PASSWORD=change-me
# Read-only account of the agent: the only one the application uses
AGENT_RO_PASSWORD=change-me
