# Copy to .env and fill in. .env is git-ignored: never commit it.

# Read by docker-compose.yaml
DB_USER=calorvia
DB_PASSWORD=change-me
DB_NAME=calorvia
# The same, as a URL, read by the application
POSTGRES_URL=postgresql://calorvia:change-me@localhost:5432/calorvia

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me

LLM_URL=http://localhost:8000/v1
EMBEDDINGS_URL=http://localhost:8001/v1
RERANK_URL=http://localhost:8002/rerank
VLM_URL=http://localhost:8003/v1
JUDGE_URL=http://localhost:8003/v1
JUDGE_MODEL=gemma4-26b-a4b

# Holds the embedder/, reranker/ and docling/ folders
MODELS_PATH=/path/to/models

# DeepEval sends usage telemetry to an external service unless told not to
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Phase B: the three source databases, restored with the course's compose file:
#   docker compose -f enonces/calorvia_t2sql/sources_calorvia/docker/docker-compose.yml -f docker-compose.sources-local.yaml --env-file .env up -d
# SQL Server: at least 8 characters with 3 of the 4 classes (upper case, lower case, digit, symbol); no apostrophe.
MSSQL_SA_PASSWORD=change-me
PG_ADMIN_USER=calorvia
PG_ADMIN_PASSWORD=change-me
# Read-only account of the agent: the only one the application uses
AGENT_RO_PASSWORD=change-me

# Step 12: the PostgreSQL copy of the ERP for auto-ontology (ontology/docker-compose.yaml, port 5436)
ERP_COPY_ADMIN_USER=calorvia
ERP_COPY_ADMIN_PASSWORD=change-me
ERP_COPY_RO_PASSWORD=change-me

# Step 24: required as soon as the endpoint listens beyond 127.0.0.1. Generate keys with: openssl rand -hex 32
# API_KEYS=alice:change-me,webui:change-me
# TRUSTED_GATEWAYS=webui      # keys allowed to name their end user (Open WebUI's X-OpenWebUI-User-Id header)
# USER_ROLES=alice:finance    # Phase D: roles of policy/roles.yaml; anyone else gets `employe` (no database)
# ADMIN_USERS=alice           # Step 47: may act as any role in app/chat.py (X-Calorvia-Act-As); local mode always may

# Step 32: Langfuse, self-hosted (monitoring/docker-compose.yaml, UI on http://localhost:3100). Tracing is off while
# LANGFUSE_PUBLIC_KEY or LANGFUSE_SECRET_KEY is empty. Generate each secret with: openssl rand -hex 32
LANGFUSE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-change-me          # created with the project at first start: any pk-lf-... string
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_ADMIN_EMAIL=admin@calorvia.local    # the UI's login, created at first start
LANGFUSE_ADMIN_PASSWORD=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=change-me            # exactly 64 hex characters
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_MINIO_PASSWORD=change-me
LANGFUSE_REDIS_PASSWORD=change-me
