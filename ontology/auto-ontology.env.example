# Template of ~/src/auto-ontology/.env for Calorvia (step 12). Copy it there and replace every change-me.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=auto_ontology

# O6, variant (a): the ERP through its PostgreSQL copy (scripts/copy_erp.py); accounting and payroll as agent_ro
CONNECTION_STRINGS=postgresql://ontology_ro:change-me@localhost:5436/gespro,postgresql://agent_ro:change-me@localhost:5433/compta,postgresql://agent_ro:change-me@localhost:5434/paie

PGADMIN_EMAIL=admin@calorvia.local
PGADMIN_PASSWORD=change-me

# Local models only. The openai/ prefix makes auto-ontology use ChatOpenAI (json_schema structured output,
# supported by llama-server) instead of ChatNVIDIA. Serve the generator with -a openai/qwen3.8-27b.
DEFAULT_MODELS_API_KEY=local
DEFAULT_MODELS_ENDPOINT=http://localhost:8000/v1
DEFAULT_MODELS_MODEL=openai/qwen3.8-27b
REASONING_API_KEY=local
REASONING_ENDPOINT=http://localhost:8000/v1
REASONING_MODEL=openai/qwen3.8-27b
NON_REASONING_API_KEY=local
NON_REASONING_ENDPOINT=http://localhost:8000/v1
NON_REASONING_MODEL=openai/qwen3.8-27b
EMBED_API_KEY=local
EMBED_ENDPOINT=http://localhost:8001/v1
EMBED_MODEL=bge-m3
# bge-m3's vector size (patches/embed-dimensions.patch); auto-ontology assumes NVIDIA's 2048
EMBED_DIMENSIONS=1024
# A URL ending in /rerank selects the {query, documents} -> results[].relevance_score format: vLLM's
RERANK_ENDPOINT=http://localhost:8002/rerank
RERANK_MODEL=bge-reranker
RERANK_API_KEY=local

# llama-server runs one slot (-np 1)
LLM_MAX_INFLIGHT=1
LLM_INVOKE_TIMEOUT_S=600

APP_URL=http://localhost:3000
AUTO_ONTOLOGY_MCP_PUBLIC_URL=http://localhost:3003
INGESTION_SERVICE_URL=http://localhost:3002
AUTO_ONTOLOGY_ADMIN_EMAIL=admin@calorvia.local
AUTO_ONTOLOGY_ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string
# KUMO_RFM_API_KEY stays unset: KumoRFM would upload the tables to a hosted service
