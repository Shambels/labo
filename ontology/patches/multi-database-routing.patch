+def _tables_in_sql(sql: str, seen: list[dict]) -> list[dict]:
+    """The seen tables a query references (Calorvia patch).
+
+    ``retrieve`` searches every database, so over an episode ``seen_tables``
+    collects tables of several of them, and routing on all of them refused every
+    query once more than one database was connected. Only the tables the query
+    names matter.
+    """
+    import sqlglot
+    from sqlglot import exp
+
+    try:
+        trees = [t for t in sqlglot.parse(sql) if t is not None]
+    except Exception:  # noqa: BLE001 - unparseable SQL: fall back to every seen table
+        return seen
+    named = {
+        (str(t.db or "").lower(), t.name.lower())
+        for tree in trees
+        for t in tree.find_all(exp.Table)
+        if t.name
+    }
+    used = [
+        table
+        for table in seen
+        if (str(table.get("schema_name") or "").lower(), str(table.get("name") or "").lower()) in named
+        or ("", str(table.get("name") or "").lower()) in named
+    ]
+    return used or seen
+
+
